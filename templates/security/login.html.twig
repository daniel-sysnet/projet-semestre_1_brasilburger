<!DOCTYPE html>
<html>
<head>
    <title>Connexion Gestionnaire</title>
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
</head>
<body>
    <form method="post">
        <h2>Connexion Gestionnaire</h2>

        {% if error %}
            <p class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}

        <input type="text" name="_username" value="{{ last_username }}" placeholder="Login" required>
        <input type="password" name="_password" placeholder="Mot de passe" required>

        <button type="submit">Connexion</button>
    </form>
</body>
</html>
