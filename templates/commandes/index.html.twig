<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commandes | Brasil Burger</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <style>
        .commandes-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .commandes-table th, .commandes-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .commandes-table th {
            background-color: #f4a62a;
            color: white;
        }
        .btn {
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn-success { background-color: #28a745; color: white; }
        .btn-danger { background-color: #dc3545; color: white; }
        .btn-primary { background-color: #007bff; color: white; }
        .btn-secondary { background-color: #6c757d; color: white; }
    </style>
</head>
<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"></div>
            <span><strong>Brasil</strong> Burger</span>
        </div>

        <p class="section-title">Espace Gestionnaire</p>

        <nav class="menu">
            <a href="{{ path('dashboard') }}">📊 Tableau de Bord</a>
            <a href="{{ path('app_statistics') }}">📈 Statistiques</a>
            <a href="{{ path('commandes_index') }}" class="active">📦 Commandes</a>
            <a href="{{ path('livreur_index') }}">🛵 Livreurs</a>
            <a href="{{ path('zone_index') }}">🏙️ Zones</a>
            <a href="{{ path('commandes_livraisons') }}">🚚 Livraisons</a>
            <a href="{{ path('logout') }}" class="logout">🚪 Déconnexion</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <!-- TOP BAR -->
        <header class="topbar">
            <span class="role gestionnaire">Gestionnaire Web</span>
            <span class="role client">Client</span>
        </header>

        <!-- CONTENT -->
        <section class="content">
            <h1>Gestion des Commandes</h1>
            <p class="subtitle">Liste de toutes les commandes</p>

            {% for message in app.flashes('success') %}
                <p style="color: green;">{{ message }}</p>
            {% endfor %}

            <!-- Filtres -->
            <div style="margin-bottom: 20px; padding: 15px; background-color: #f8f9fa; border-radius: 5px;">
                <h3>Filtres</h3>
                <form method="GET" action="{{ path('commandes_index') }}" style="display: flex; flex-wrap: wrap; gap: 10px; align-items: end;">
                    <div>
                        <label for="etat">État :</label><br>
                        <select name="etat" id="etat">
                            <option value="">Tous</option>
                            <option value="En attente" {{ filters.etat == 'En attente' ? 'selected' : '' }}>En attente</option>
                            <option value="Validée" {{ filters.etat == 'Validée' ? 'selected' : '' }}>Validée</option>
                            <option value="Terminée" {{ filters.etat == 'Terminée' ? 'selected' : '' }}>Terminée</option>
                            <option value="Annulée" {{ filters.etat == 'Annulée' ? 'selected' : '' }}>Annulée</option>
                        </select>
                    </div>
                    <div>
                        <label for="date">Date (YYYY-MM-DD) :</label><br>
                        <input type="date" name="date" id="date" value="{{ filters.date }}">
                    </div>
                    <div>
                        <label for="client">Client :</label><br>
                        <input type="text" name="client" id="client" value="{{ filters.client }}" placeholder="Nom du client">
                    </div>
                    <div>
                        <label for="burger">Burger :</label><br>
                        <input type="text" name="burger" id="burger" value="{{ filters.burger }}" placeholder="Nom du burger">
                    </div>
                    <div>
                        <label for="menu">Menu :</label><br>
                        <input type="text" name="menu" id="menu" value="{{ filters.menu }}" placeholder="Nom du menu">
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary">Filtrer</button>
                        <a href="{{ path('commandes_index') }}" class="btn btn-secondary" style="margin-left: 10px;">Réinitialiser</a>
                    </div>
                </form>
            </div>

            <table class="commandes-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>État</th>
                        <th>Type</th>
                        <th>Zone</th>
                        <th>Livreur</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td>{{ commande.id }}</td>
                            <td>{{ commande.client.nom }} {{ commande.client.prenom }}</td>
                            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                            <td>{{ commande.etat }}</td>
                            <td>{{ commande.type }}</td>
                            <td>{{ commande.zone ? commande.zone.nom : '-' }}</td>
                            <td>{{ commande.livreur ? commande.livreur.nom ~ ' ' ~ commande.livreur.prenom : '-' }}</td>
                            <td>
                                <a href="{{ path('commandes_show', {id: commande.id}) }}" class="btn btn-primary">Voir</a>
                                {% if commande.etat == 'En cours' %}
                                    <form method="post" action="{{ path('commandes_valider', {id: commande.id}) }}" style="display: inline;">
                                        <button type="submit" class="btn btn-success">Valider</button>
                                    </form>
                                {% endif %}
                                {% if commande.etat == 'Validee' %}
                                    <form method="post" action="{{ path('commandes_terminer', {id: commande.id}) }}" style="display: inline;">
                                        <button type="submit" class="btn btn-success">Terminer</button>
                                    </form>
                                {% endif %}
                                {% if commande.etat == 'Validee' and not commande.paiement %}
                                    <form method="post" action="{{ path('commandes_payer', {id: commande.id}) }}" style="display: inline;">
                                        <select name="methode" required style="margin-right: 5px;">
                                            <option value="">Méthode</option>
                                            <option value="Wave">Wave</option>
                                            <option value="Orange Money">Orange Money</option>
                                        </select>
                                        <button type="submit" class="btn btn-primary">Payer</button>
                                    </form>
                                {% endif %}
                                {% if commande.etat in ['En cours', 'Validee'] %}
                                    <form method="post" action="{{ path('commandes_annuler', {id: commande.id}) }}" style="display: inline;">
                                        <button type="submit" class="btn btn-danger">Annuler</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>

</div>

</body>
</html>