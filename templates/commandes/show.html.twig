<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Détails Commande | Brasil Burger</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <style>
        .details { margin-top: 20px; }
        .details p { margin: 5px 0; }
        .lignes { margin-top: 20px; }
        .lignes table { width: 100%; border-collapse: collapse; }
        .lignes th, .lignes td { padding: 8px; border: 1px solid #ddd; text-align: left; }
        .lignes th { background-color: #f4a62a; color: white; }
        .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; margin: 5px; }
        .btn-secondary { background-color: #6c757d; color: white; }
    </style>
</head>
<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"></div>
            <span><strong>Brasil</strong> Burger</span>
        </div>

        <p class="section-title">Espace Gestionnaire</p>

        <nav class="menu">
            <a href="{{ path('dashboard') }}">📊 Tableau de Bord</a>
            <a href="{{ path('app_statistics') }}">📈 Statistiques</a>
            <a href="{{ path('commandes_index') }}" class="active">📦 Commandes</a>
            <a href="{{ path('livreur_index') }}">🛵 Livreurs</a>
            <a href="{{ path('zone_index') }}">🏙️ Zones</a>
            <a href="{{ path('client_index') }}">👥 Clients</a>
            <a href="{{ path('commandes_livraisons') }}">🚚 Livraisons</a>
            <a href="{{ path('logout') }}" class="logout">🚪 Déconnexion</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <!-- TOP BAR -->
        <header class="topbar">
            <span class="role gestionnaire">Gestionnaire Web</span>
            <span class="role client">Client</span>
        </header>

        <!-- CONTENT -->
        <section class="content">
            <h1>Détails de la Commande #{{ commande.id }}</h1>

            <div class="details">
                <p><strong>Client :</strong> {{ commande.client.nom }} {{ commande.client.prenom }} ({{ commande.client.telephone }})</p>
                <p><strong>Date :</strong> {{ commande.dateCommande|date('d/m/Y H:i') }}</p>
                <p><strong>État :</strong> {{ commande.etat }}</p>
                <p><strong>Type :</strong> {{ commande.type }}</p>
                <p><strong>Zone :</strong> {{ commande.zone ? commande.zone.nom : 'Aucune' }}</p>
                <p><strong>Livreur :</strong> {{ commande.livreur ? commande.livreur.nom ~ ' ' ~ commande.livreur.prenom : 'Aucun' }}</p>
                {% if commande.paiement %}
                    <p><strong>Paiement :</strong> {{ commande.paiement.montant|number_format(2, ',', ' ') }} FCFA via {{ commande.paiement.methode }} le {{ commande.paiement.datePaiement|date('d/m/Y H:i') }}</p>
                {% else %}
                    <p><strong>Paiement :</strong> Non payé</p>
                {% endif %}
            </div>

            <div class="lignes">
                <h2>Détails des produits commandés</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Nom</th>
                            <th>Quantité</th>
                            <th>Prix unitaire (FCFA)</th>
                            <th>Total (FCFA)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set totalCommande = 0 %}
                        {% for ligne in commande.ligneCommandes %}
                            <tr>
                                <td>
                                    {% if ligne.burger %}🍔 Burger{% elseif ligne.menu %}🍟 Menu{% elseif ligne.complement %}🥤 Complément{% endif %}
                                </td>
                                <td>
                                    {% if ligne.burger %}{{ ligne.burger.nom }}{% elseif ligne.menu %}{{ ligne.menu.nom }}{% elseif ligne.complement %}{{ ligne.complement.nom }}{% endif %}
                                </td>
                                <td>{{ ligne.quantite }}</td>
                                <td>
                                    {% if ligne.burger %}{{ ligne.burger.prix|number_format(2, ',', ' ') }}{% elseif ligne.menu %}{{ ligne.menu.prix|number_format(2, ',', ' ') }}{% elseif ligne.complement %}{{ ligne.complement.prix|number_format(2, ',', ' ') }}{% endif %}
                                </td>
                                <td>
                                    {% set prixUnitaire = 0 %}
                                    {% if ligne.burger %}{% set prixUnitaire = ligne.burger.prix %}{% elseif ligne.menu %}{% set prixUnitaire = ligne.menu.prix %}{% elseif ligne.complement %}{% set prixUnitaire = ligne.complement.prix %}{% endif %}
                                    {% set totalLigne = prixUnitaire * ligne.quantite %}
                                    {{ totalLigne|number_format(2, ',', ' ') }}
                                    {% set totalCommande = totalCommande + totalLigne %}
                                </td>
                            </tr>
                        {% endfor %}
                        <tr style="font-weight: bold; background-color: #f4a62a; color: white;">
                            <td colspan="4">Total de la commande</td>
                            <td>{{ totalCommande|number_format(2, ',', ' ') }} FCFA</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <a href="{{ path('commandes_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </section>
    </main>

</div>

</body>
</html>