{% extends 'base.html.twig' %}

{% block title %}Statistiques | Brasil Burger{% endblock %}

{% block body %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Statistiques | Brasil Burger</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
</head>
<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"></div>
            <span><strong>Brasil</strong> Burger</span>
        </div>

        <p class="section-title">Espace Gestionnaire</p>

        <nav class="menu">
            <a href="{{ path('dashboard') }}">📊 Tableau de Bord</a>
            <a href="{{ path('app_statistics') }}" class="active">📈 Statistiques</a>
            <a href="{{ path('commandes_index') }}">📦 Commandes</a>
            <a href="{{ path('livreur_index') }}">🛵 Livreurs</a>
            <a href="{{ path('commandes_livraisons') }}">🚚 Livraisons</a>
            <a href="{{ path('logout') }}" class="logout">🚪 Déconnexion</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <!-- TOP BAR -->
        <header class="topbar">
            <span class="role gestionnaire">Gestionnaire Web</span>
            <span class="role client">Client</span>
        </header>

        <!-- CONTENT -->
        <section class="content">
            <h1>Statistiques</h1>
            <p class="subtitle">Aperçu général des performances</p>

            <div class="cards">
                <div class="card">
                    <p class="card-title">Nombre total de commandes</p>
                    <p class="card-value blue">{{ nombreTotalCommandes }}</p>
                    <p class="card-footer">Depuis le début</p>
                </div>

                <div class="card">
                    <p class="card-title">Chiffre d'affaires total</p>
                    <p class="card-value green">{{ chiffreAffairesTotal|number_format(2, ',', ' ') }} FCFA</p>
                    <p class="card-footer">Commandes validées</p>
                </div>

                <div class="card">
                    <p class="card-title">Revenus aujourd'hui</p>
                    <p class="card-value orange">{{ revenusAujourdhui|number_format(2, ',', ' ') }} FCFA</p>
                    <p class="card-footer">Journée en cours</p>
                </div>

                <div class="card">
                    <p class="card-title">Commandes en cours du jour</p>
                    <p class="card-value yellow">{{ commandesEnCoursDuJour }}</p>
                    <p class="card-footer">Aujourd'hui</p>
                </div>

                <div class="card">
                    <p class="card-title">Commandes validées du jour</p>
                    <p class="card-value green">{{ commandesValideesDuJour }}</p>
                    <p class="card-footer">Aujourd'hui</p>
                </div>

                <div class="card">
                    <p class="card-title">Commandes annulées du jour</p>
                    <p class="card-value red">{{ commandesAnnuleesDuJour }}</p>
                    <p class="card-footer">Aujourd'hui</p>
                </div>
            </div>

            <div class="stats-section">
                <h2>Commandes par état</h2>
                <ul>
                    {% for etat, nombre in commandesParEtat %}
                        <li>{{ etat }}: {{ nombre }}</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="stats-section">
                <h2>Top Produits</h2>
                <h3>Burgers les plus vendus</h3>
                <ul>
                    {% for burger in topProduits.burgers %}
                        <li>{{ burger.nom }}: {{ burger.total }} unités</li>
                    {% endfor %}
                </ul>
                <h3>Menus les plus vendus</h3>
                <ul>
                    {% for menu in topProduits.menus %}
                        <li>{{ menu.nom }}: {{ menu.total }} unités</li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    </main>
</div>
</body>
</html>
{% endblock %}
