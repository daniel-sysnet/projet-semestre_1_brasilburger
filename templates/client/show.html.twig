<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Détails Client | Brasil Burger</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <style>
        .commandes-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .commandes-table th, .commandes-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .commandes-table th {
            background-color: #f4a62a;
            color: white;
        }
        .btn {
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn-primary { background-color: #007bff; color: white; }
    </style>
</head>
<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"></div>
            <span><strong>Brasil</strong> Burger</span>
        </div>

        <p class="section-title">Espace Gestionnaire</p>

        <nav class="menu">
            <a href="{{ path('dashboard') }}">📊 Tableau de Bord</a>
            <a href="{{ path('app_statistics') }}">📈 Statistiques</a>
            <a href="{{ path('commandes_index') }}">📦 Commandes</a>
            <a href="{{ path('livreur_index') }}">🛵 Livreurs</a>
            <a href="{{ path('zone_index') }}">🏙️ Zones</a>
            <a href="{{ path('client_index') }}" class="active">👥 Clients</a>
            <a href="{{ path('commandes_livraisons') }}">🚚 Livraisons</a>
            <a href="{{ path('logout') }}" class="logout">🚪 Déconnexion</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <!-- TOP BAR -->
        <header class="topbar">
            <span class="role gestionnaire">Gestionnaire Web</span>
            <span class="role client">Client</span>
        </header>

        <!-- CONTENT -->
        <section class="content">
            <h1>Détails du Client</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>ID</th>
                        <td>{{ client.id }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ client.nom }}</td>
                    </tr>
                    <tr>
                        <th>Prénom</th>
                        <td>{{ client.prenom }}</td>
                    </tr>
                    <tr>
                        <th>Téléphone</th>
                        <td>{{ client.telephone }}</td>
                    </tr>
                </tbody>
            </table>

            <h2>Historique des Commandes</h2>
            <table class="commandes-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>État</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in client.commandes %}
                        <tr>
                            <td>{{ commande.id }}</td>
                            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                            <td>{{ commande.type }}</td>
                            <td>{{ commande.etat }}</td>
                            <td>{{ commande.total }} FCFA</td>
                            <td>
                                <a href="{{ path('commandes_show', {'id': commande.id}) }}" class="btn btn-primary">Voir Détails</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">Aucune commande trouvée pour ce client.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('client_index') }}" class="btn btn-primary">Retour à la liste</a>
        </section>
    </main>
</div>

</body>
</html>