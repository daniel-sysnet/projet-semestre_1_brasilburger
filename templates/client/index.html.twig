<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Clients | Brasil Burger</title>
    <link rel="stylesheet" href="{{ asset('style.css') }}">
    <style>
        .clients-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .clients-table th, .clients-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }
        .clients-table th {
            background-color: #f4a62a;
            color: white;
        }
        .btn {
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn-success { background-color: #28a745; color: white; }
    </style>
</head>
<body>

<div class="app">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="brand">
            <div class="logo"></div>
            <span><strong>Brasil</strong> Burger</span>
        </div>

        <p class="section-title">Espace Gestionnaire</p>

        <nav class="menu">
            <a href="{{ path('dashboard') }}">📊 Tableau de Bord</a>
            <a href="{{ path('app_statistics') }}">📈 Statistiques</a>
            <a href="{{ path('commandes_index') }}">📦 Commandes</a>
            <a href="{{ path('livreur_index') }}">🛵 Livreurs</a>
            <a href="{{ path('zone_index') }}">🏙️ Zones</a>
            <a href="{{ path('client_index') }}" class="active">👥 Clients</a>
            <a href="{{ path('commandes_livraisons') }}">🚚 Livraisons</a>
            <a href="{{ path('logout') }}" class="logout">🚪 Déconnexion</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="main">
        <!-- TOP BAR -->
        <header class="topbar">
            <span class="role gestionnaire">Gestionnaire Web</span>
            <span class="role client">Client</span>
        </header>

        <!-- CONTENT -->
        <section class="content">
            <h1>Gestion des Clients</h1>
            <p class="subtitle">Liste de tous les clients</p>

            <table class="clients-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Téléphone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for client in clients %}
                        <tr>
                            <td>{{ client.id }}</td>
                            <td>{{ client.nom }}</td>
                            <td>{{ client.prenom }}</td>
                            <td>{{ client.telephone }}</td>
                            <td>
                                <a href="{{ path('client_show', {'id': client.id}) }}" class="btn btn-success">Voir Historique</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5">Aucun client trouvé.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</div>

</body>
</html>